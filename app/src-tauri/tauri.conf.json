{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vardo",
  "version": "0.0.2",
  "identifier": "app.vardo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vardo",
        "width": 1024,
        "height": 768,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "KDBX password manager",
    "resources": {
      "../../extension/manifest.json": "extension/manifest.json",
      "../../extension/icons/": "extension/icons/",
      "../../extension/src/": "extension/src/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1NTVBNTg5NTQ0NTk0MDMKUldRRGxFVlVpYVZWNVN2TmpnMThCVXlqd1JDT01mWEVLYWNMVHdBa2JNZnM3L1NkNzE3WjljZUEK",
      "endpoints": [
        "https://github.com/cornellsh/vardo/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
